// User Model
model User {
    id          String      @id @default(cuid(2))
    email       String      @unique
    username    String      @unique
    password    String
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    characters  UserCharacter[]
}

// UserCharacter join Model
model UserCharacter {
    userId                  String
    characterId             Int
    characterLevel          Int         @default(1)
    characterAscension      Int         @default(0)
    friendshipLevel         Int         @default(0)
    normalAttackLevel       Int         @default(1)
    elementalSkillLevel     Int         @default(1)
    elementalBurstLevel     Int         @default(1)
    hexereiUnlocked         Boolean     @default(false)
    constellation           Int         @default(0)

    // weapon, artifact set etc later

    user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    character       Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

    @@id([userId, characterId])
}